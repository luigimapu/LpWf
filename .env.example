DB_HOST=xxx.xxx.xxx.xxx
DB_NAME=xxx
DB_USER=xxx
DB_PASS=xxx
JWT_SECRET=change-me
JWT_ISS=LpWF
JWT_EXP_SECONDS=3600
HUB_API_BASE=https://hub.example.com/api/v1
HUB_API_KEY=your_hub_api_key
TENANT_ID=
HUB_DB_HOST=xxx
HUB_DB_NAME=hub_catalogo
HUB_DB_USER=xxx
HUB_DB_PASS=xxx
HUB_SHARED_SECRET=change-me
HUB_API_VERIFY_SSL=1
SERVICES_VERIFY_SSL=1

# WhatsApp provider: twilio|meta (optional). If unset -> simulate
WHATSAPP_PROVIDER=
# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
# (Opzionale) invio via Template per prime conversazioni
# Imposta il nome del template approvato per inviare fuori dalla finestra 24h
META_WHATSAPP_TEMPLATE_NAME=
# Codice lingua del template (es. it, en_US)
META_WHATSAPP_TEMPLATE_LANG=it

# Email provider: smtp|mailgun|sendgrid|mailup (default smtp)
EMAIL_PROVIDER=smtp
SMTP_FROM=noreply@example.com
# For SMTP provider we use PHP mail(); for Mailgun/Sendgrid set keys below
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SENDGRID_API_KEY=

# MailUp (opzionale)
# Opzione A – Webhook bridge (consigliato se non vuoi integrare direttamente le API MailUp qui):
MAILUP_WEBHOOK_URL=
# Opzione B – Integrazione diretta via OAuth (API MailUp)
MAILUP_CLIENT_ID=
MAILUP_CLIENT_SECRET=
MAILUP_USERNAME=
MAILUP_PASSWORD=
MAILUP_FROM=noreply@example.com
MAILUP_FROM_NAME=
MAILUP_REPLY_TO=
MAILUP_TOKEN_URL=https://services.mailup.com/Authorization/OAuth/Token
# Endpoint di invio (varia secondo il prodotto MailUp adottato – Console API/Send API). Esempio: https://send.mailup.com/api/v1.0/TransactionalEmails
MAILUP_SEND_URL=

# Payment (Stripe) optional
STRIPE_API_KEY=
PAYMENT_CURRENCY=EUR

# Optional webhooks (if set, services post payload to these endpoints)
ORDER_WEBHOOK_URL=
DOCUMENT_WEBHOOK_URL=
PAYMENT_WEBHOOK_URL=
TICKET_WEBHOOK_URL=
CHAT_WEBHOOK_URL=
TICKET_FORWARD_ON_CREATE=0
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GOOGLE_MAPS_EMBED_API_KEY=
MAX_TICKET_ATTACHMENT_MB=10
