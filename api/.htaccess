RewriteEngine On

# Assicura che l'header Authorization arrivi a PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Non applicare le regole a file o directory esistenti (come il nostro index.php!)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Reindirizza tutte le altre richieste a index.php
# La parte (.*) cattura l'URL richiesto (es. "tasks/1") e lo passa come parametro "url"
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
